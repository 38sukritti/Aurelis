    {
      "name": "5. CSV Import and Export",
      "item": [
        {
          "name": "Import rows",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/transactions/import",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "transactions",
                "import"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"transactions\": [\n    {\n      \"importRef\": \"TXN001\",\n      \"date\": \"2026-08-01\",\n      \"amount\": 350,\n      \"category\": \"Food\",\n      \"merchant\": \"Starbucks Coffee\",\n      \"paymentMethod\": \"Debit Card\"\n    },\n    {\n      \"importRef\": \"TXN002\",\n      \"date\": \"2026-08-02\",\n      \"amount\": 420,\n      \"category\": \"Food\",\n      \"merchant\": \"Local Diner Lunch\",\n      \"paymentMethod\": \"UPI\"\n    },\n    {\n      \"importRef\": \"TXN003\",\n      \"date\": \"2026-08-03\",\n      \"amount\": 390,\n      \"category\": \"Food\",\n      \"merchant\": \"Bistro Cafe\",\n      \"paymentMethod\": \"Credit Card\"\n    },\n    {\n      \"importRef\": \"TXN004\",\n      \"date\": \"bad-date\",\n      \"amount\": 100,\n      \"category\": \"Food\",\n      \"merchant\": \"Invalid row\"\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "The web app parses the CSV file in the browser (js/csv.js) and sends the rows here. Every row is validated again. importRef (the CSV Transaction_ID) prevents duplicates when the same file is imported twice."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201 (or 200 if already imported)', () => pm.expect(pm.response.code).to.be.oneOf([200, 201]));",
                  "pm.test('Invalid row reported', () => pm.expect(pm.response.json().data.invalidCount).to.eql(1));"
                ]
              }
            }
          ]
        },
        {
          "name": "Import same rows again - skipped as duplicates",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/transactions/import",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "transactions",
                "import"
              ]
            },
            "body": {
              "mode": "raw",
