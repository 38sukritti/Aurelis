# Port the API listens on. Render sets this automatically.
# (Avoid 5000 on macOS - AirPlay Receiver uses it.)
PORT=5050

# MongoDB Atlas connection string, including the database name, e.g.
# mongodb+srv://<user>:<password>@<cluster>.mongodb.net/aurelis?retryWrites=true&w=majority
MONGODB_URI=

# Long random string used to sign login tokens. Generate one with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# How long a login lasts before the user must sign in again.
JWT_EXPIRES_IN=7d

# Comma-separated list of frontend origins allowed to call the API, e.g.
# https://aurelis.netlify.app,https://38sukritti.github.io
# Not needed when the frontend is served by this backend (SERVE_FRONTEND).
CLIENT_URL=

# development | production | test
NODE_ENV=development

# Serve the existing HTML/CSS/JS frontend from this server as well.
SERVE_FRONTEND=true

# Allow the "Demo Login" button (shared demo account with sample data).
ENABLE_DEMO_LOGIN=true
